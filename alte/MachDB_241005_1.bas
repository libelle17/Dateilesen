  "nth,1) and coalesce(`i`.`ahbis` > `i`.`gsbis` - interval 3 month,1) then 'ah' when `i`.`tkbis` > `i`.`gsbis` and `i`.`tkbis` > `i`.`ahbis` and `i`.`tkzahl` > 0 then 'tk' when `i`.`gsbis` > `i`.`tkbis` and `i`.`gsbis` > `i`.`ahbis` and `i`.`gszahl` > 5 then 'gs' when `i`.`ahbis` > `i`.`tkbis` and `i`.`ahbis` > `i`.`tkbis` and `i`.`ahzahl` > 0 then 'ah' when `i`.`obtk` <> 0 and `i`.`obgs` = 0 and `i`.`obdw` = 0 and `i`.`obah` = 0 and `i`.`gszahl` < 6 and `i`.`dwzahl` = 0 and `i`.`ahzahl` = 0 then 'tk' when `i`.`obah` <> 0 and `i`.`obgs` = 0 and `i`.`obtk` = 0 and `i`.`obdw` = 0 and `i`.`gszahl` < 6 and `i`.`dwzahl` = 0 and `i`.`ahzahl` = 0 then 'ah' when `i`.`obtk` = 0 and `i`.`obgs` = 0 and `i`.`obdw` = 0 and `i`.`obah` = 0 and `i`.`tkbis` = 0 and `i`.`gsbis` = 0 and `i`.`dwbis` = 0 and `i`.`ahbis` = 0 then '-' else '' end AS `wer`,`i`.`Prim` AS `Prim`,`i`.`PID` AS `PID`,`i`.`obtk` AS `ob" & _
