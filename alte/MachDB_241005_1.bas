  " `qanf`(),'',`d`.`ICD`)),'') AS `gicdok`,if(`d`.`DiagSicherheit` in ('G',' '),if(`d`.`obDauer`,if(`kori`(),if(`d`.`obKasse` <> 0 and `d`.`lKasse` > `qanf`(),`d`.`ICD`,''),if(`d`.`Dggel`,'',`d`.`ICD`)),if(`d`.`DiagDatum` < `qanf`(),'',`d`.`ICD`)),'') AS `gicd`,if(`d`.`DiagSicherheit` in ('G',' ','Z'),if(`d`.`obDauer`,if(`d`.`obKasse` <> 0 and `d`.`lKasse` > `qanf`(),`d`.`ICD`,''),if(`d`.`DiagDatum` < `qanf`(),'',`d`.`ICD`)),'') AS `gzicdko`,if(`d`.`DiagSicherheit` in ('G',' ','Z'),if(`d`.`obDauer`,if(`d`.`Dggel`,'',`d`.`ICD`),if(`d`.`DiagDatum` < `qanf`(),'',`d`.`ICD`)),'') AS `gzicdok`,if(`d`.`DiagSicherheit` in ('G',' ','Z'),if(`d`.`obDauer`,if(`kori`(),if(`d`.`obKasse` <> 0 and `d`.`lKasse` > `qanf`(),`d`.`ICD`,''),if(`d`.`Dggel`,'',`d`.`ICD`)),if(`d`.`DiagDatum` < `qanf`(),'',`d`.`ICD`)),'') AS `gzicd` from `diagnosen` `d`"
