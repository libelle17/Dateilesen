Sub FüllStr3()
 Str(0, 3, 0) = "aktfkvs"
 Str(1, 3, 0) = "CREATE ALGORITHM=UNDEFINED DEFINER=`praxis`@`%` SQL SECURITY DEFINER VIEW `aktfkvs` AS select `f`.`pat_id` AS `pat_id`,count(distinct `kontkte`.`zp`) AS `koz`,`f`.`quartal` AS `quartal`,coalesce(group_concat(distinct date_format(`kontkte`.`zp`,'%e.%c.') order by `kontkte`.`zp` ASC separator '•'),'') AS `czp`,coalesce(min(`kontkte`.`zp`),'') AS `erst`,coalesce(max(`kontkte`.`zp`),'') AS `letzt`,`f`.`fid` AS `fid`,`f`.`schgr` AS `schgr`,`f`.`vknr` AS `vknr`,`f`.`ik` AS `ik`,`f`.`lanrid` AS `lanrid`,coalesce(group_concat(`kontkte`.`Typ` order by `kontkte`.`zp` ASC separator '•'),'') AS `Typ`,coalesce(group_concat(`kontkte`.`Art` order by `kontkte`.`zp` ASC separator '•'),'') AS `Art` from (`aktfv` `f` left join `kontkte` on(`f`.`pat_id` = `kontkte`.`pat_id`)) group by `f`.`pat_id`"
End Sub ' FüllStr3

