  "p`.`oNw` = '',`p`.`oNm`,`p`.`oNw`) AS `oNg`,_utf8mb4'TM' collate utf8mb4_german2_ci AS `Labor`,_utf8mb4'' collate utf8mb4_german2_ci AS `Pfad`,0 AS `DatID`,`p`.`Gruppe` AS `Gruppe`,`p`.`Reihe` AS `Reihe`,1 AS `Qu` from ((((`laborneu` `n` left join `namen` `na` on(`n`.`Pat_ID` = `na`.`Pat_ID`)) left join `laborlangtext` `l` on(`l`.`LangtextVW` = `n`.`LangtextVW`)) left join `laborkommentar` `k` on(`k`.`KommentarVW` = `n`.`KommentarVW`)) left join `laborparameter` `p` on(`n`.`Abkü` = `p`.`Abkü` and `n`.`Einheit` = if(`p`.`Einheit` in ('','\'kA\''),'kA',`p`.`Einheit`))) where `n`.`Wert` <> '' and `n`.`Wert` is not null or `k`.`Kommentar` <> '' and `k`.`Kommentar` is not null"
