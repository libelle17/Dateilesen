 Str(1, 61, 0) = "CREATE ALGORITHM=UNDEFINED DEFINER=`praxis`@`%` SQL SECURITY DEFINER VIEW `dtypview` AS select `n`.`Pat_ID` AS `pat_id`,`d`.`dmtyp` AS `dmtyp` from (`namen` `n` left join (select `d`.`Pat_id` AS `pat_id`,case when `d`.`ICD` regexp '^E' then cast(substr(`d`.`ICD`,3,1) + 1 as char charset utf8mb4) when `d`.`ICD` regexp '^R' then 'p' else 'g' end AS `dmtyp` from `diagview` `d` where `d`.`gicd` regexp '^E1[0-4].|^R73' or `d`.`ICD` = 'O24.4' and `d`.`Dggel` = 0 and `d`.`DiagSicherheit` in ('G',' ') group by `d`.`Pat_id`) `d` on(`d`.`pat_id` = `n`.`Pat_ID`))"
End Sub ' FüllStr61

