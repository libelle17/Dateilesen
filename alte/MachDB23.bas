 Str(1, 226, 0) = "CREATE ALGORITHM=UNDEFINED DEFINER=`praxis`@`%` SQL SECURITY DEFINER VIEW `_HbA1cMinMax` AS SELECT `n`.`Pat_ID` AS `pat_id`,(SELECT min(CAST(`labor1a`.`Wert` AS decimal(9,2))) FROM `labor1a` WHERE `labor1a`.`Pat_ID` = `n`.`Pat_ID` AND `labor1a`.`Abkü` regexp '^hba[1c]' AND `labor1a`.`Wert` regexp '^[0-9]+\\.?[0-9]*$' AND `labor1a`.`Wert` < 21) AS `min1`,(SELECT min(CAST(`labor2a`.`Wert` AS decimal(9,2))) FROM `labor2a` WHERE `labor2a`.`Pat_id` = `n`.`Pat_ID` AND `labor2a`.`Abkü` regexp '^hba[1c]' AND `labor2a`.`Wert` regexp '^[0-9]+\\.?[0-9]*$' AND `labor2a`.`Wert` < 21) AS `min2`,(SELECT max(CAST(`labor1a`.`Wert` AS decimal(9,2))) FROM `labor1a` WHERE `labor1a`.`Pat_ID` = `n`.`Pat_ID` AND `labor1a`.`Abkü` regexp '^hba[1c]' AND `labor1a`.`Wert` regexp '^[0-9]+\\.?[0-9]*$' AND `labor1a`.`Wert` < 21) AS `max1`,(SELECT max(CAST(`labor2a`.`Wert` AS decimal(9,2))) FROM `lab" & _
  "or2a` WHERE `labor2a`.`Pat_id` = `n`.`Pat_ID` AND `labor2a`.`Abkü` regexp '^hba[1c]' AND `labor2a`.`Wert` regexp '^[0-9]+\\.?[0-9]*$' AND `labor2a`.`Wert` < 21) AS `max2` FROM `namen` `n`"
End Sub ' FüllStr226

