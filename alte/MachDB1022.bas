  "`medplan`.`ZeitPunkt` desc,`medplan`.`MPNr` desc limit 1) and `mp`.`ZeitPunkt` = (select `medplan`.`ZeitPunkt` from `medplan` where `medplan`.`Pat_ID` = `mp`.`Pat_ID` order by `medplan`.`Pat_ID`,`medplan`.`ZeitPunkt` desc,`medplan`.`MPNr` desc limit 1)"
