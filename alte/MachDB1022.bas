  "ext` like '%alb%' and `w`.`Einheit` like 'mg/g%' and `u`.`Eingang` > cast((select concat(year(current_timestamp() - interval 200 day),'-',(month(current_timestamp() - interval 200 day) - 1) DIV 3 * 3 + 1,'-01')) as date)) AS `min2`,(select max(cast(`labor1a`.`Wert` as decimal(9,2))) from `labor1a` where `labor1a`.`Pat_ID` = `n`.`Pat_ID` and `labor1a`.`Abkü` in ('albcre','albkre','albq','album','albup') and `labor1a`.`Wert` regexp '^[0-9]+\\.?[0-9]*$' and `labor1a`.`Langtext` like '%alb%' and `labor1a`.`Einheit` like 'mg/g%' and `labor1a`.`ZeitPunkt` > cast((select concat(year(current_timestamp() - interval 200 day),'-',(month(current_timestamp() - interval 200 day) - 1) DIV 3 * 3 + 1,'-01')) as date)) AS `max1`,(select max(cast(`w`.`Wert` as decimal(9,2))) from (`laborywert` `w` join `laboryus` `u` on(`w`.`UsID` = `u`.`ID`)) where `u`.`Pat_id` = `n`.`Pat_ID` and `w`.`Abkü` in ('albcre','" & _ 
