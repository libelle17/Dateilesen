  "`.`DiagDatum` between `qanf`() and `qend`())) AS `dicd`,`f`.`pat_id` AS `pat_id`,`f`.`fid` AS `fid`,`f`.`schgr` AS `schgr`,`f`.`vknr` AS `vknr`,`f`.`ik` AS `ik`,`f`.`goäkatnr` AS `goäkatnr`,`f`.`lanrid` AS `lanrid`,`f`.`quartal` AS `quartal`,`f`.`kateg` AS `kateg` from (`aktfv` `f` left join `therarten` `t` on(`t`.`pat_id` = `f`.`pat_id` and `t`.`zp` between coalesce((select max(`therarten`.`zp`) from `therarten` where `therarten`.`pat_id` = `f`.`pat_id` and `therarten`.`zp` < `qanf`()),19000101) and `qend`())) group by `f`.`pat_id`,`rang`(`t`.`therart`) desc) `i` group by `i`.`pat_id`"
