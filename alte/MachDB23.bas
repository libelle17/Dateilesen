  "  NOT LIKE '%urin%' AND `labor2a`.`Einheit` = 'mg/dl' AND `labor2a`.`Zeitpunkt` > CAST((SELECT concat(year(current_timestamp() - interval 200 day),'-',(month(current_timestamp() - interval 200 day) - 1) DIV 3 * 3 + 1,'-01')) AS date)) AS `min2`,(SELECT max(CAST(`labor1a`.`Wert` AS decimal(9,2))) FROM `labor1a` WHERE `labor1a`.`Pat_ID` = `n`.`Pat_ID` AND `labor1a`.`abk_ur` in ('kre02','creat','krea','krea02') AND `labor1a`.`Wert` regexp '^[0-9]+\\.?[0-9]*$' AND `labor1a`.`Langtext`  NOT LIKE '%urin%' AND `labor1a`.`Einheit` = 'mg/dl' AND `labor1a`.`ZeitPunkt` > CAST((SELECT concat(year(current_timestamp() - interval 200 day),'-',(month(current_timestamp() - interval 200 day) - 1) DIV 3 * 3 + 1,'-01')) AS date)) AS `max1`,(SELECT max(CAST(`labor2a`.`Wert` AS decimal(9,2))) FROM `labor2a` WHERE `labor2a`.`Pat_id` = `n`.`Pat_ID` AND `labor2a`.`abk_ur` in ('kre02','creat','krea','krea02') and" & _
