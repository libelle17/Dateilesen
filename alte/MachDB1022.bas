Sub FüllStr145()
 Str(0, 145, 0) = "_maxGluc"
 Str(1, 145, 0) = "CREATE ALGORITHM=UNDEFINED DEFINER=`praxis`@`%` SQL SECURITY DEFINER VIEW `_maxGluc` AS select `n`.`Pat_ID` AS `pat_id`,(select max(cast(`labor1a`.`Wert` as decimal(9,2))) from `labor1a` where `labor1a`.`Pat_ID` = `n`.`Pat_ID` and `labor1a`.`Abkü` regexp '^glu' and `labor1a`.`Wert` regexp '^[0-9]+\\.?[0-9]*$' and `labor1a`.`Einheit` = 'mg/dl') AS `max1`,(select max(cast(`w`.`Wert` as decimal(9,2))) from (`laborywert` `w` join `laboryus` `u` on(`w`.`UsID` = `u`.`ID`)) where `u`.`Pat_id` = `n`.`Pat_ID` and `w`.`Abkü` regexp '^glu' and `w`.`Wert` regexp '^[0-9]+\\.?[0-9]*$' and `w`.`Einheit` = 'mg/dl') AS `max2` from `namen` `n`"
End Sub ' FüllStr145

Sub FüllStr146()
 Str(0, 146, 0) = "anb_neuman"
 Str(1, 146, 0) = "CREATE ALGORITHM=UNDEFINED DEFINER=`praxis`@`%` SQL SECURITY DEFINER VIEW `anb_neuman` AS select if(`a`.`DsJ` = '',coalesce(`a`.`erstandm`,`a`.`vorgestellt`),`a`.`DsJ`) >= substr(`aktq`(),2) - if(left(`aktq`() collate utf8mb3_general_ci,1) = '1',1,0) and `a`.`obicd` <> 0 and !(`a`.`Diabetes seit` regexp 'Jahr|Jugend|Kindheit|a$|J$|l[aä]ng|weiß|^[0-9]{1,2}.[0-9]$') AS `obneu`,`a`.`DsJ` AS `DsJ`,`a`.`Diabetes seit` AS `Diabetes seit`,`a`.`obicd` AS `obicd`,`a`.`pat_id` AS `pat_id`,`a`.`vorgestellt` AS `vorgestellt`,`a`.`bmi` AS `bmi`,`a`.`erstandm` AS `erstandm` from (select case when `a`.`Diabetes seit` regexp '[ ./][0-9]{4}$' then right(`a`.`Diabetes seit`,4) when `a`.`Diabetes seit` regexp '[ -./][4-9][0-9]$' then concat('19',right(`a`.`Diabetes seit`,2)) when `a`.`Diabetes seit` regexp '[ -./][0-3][0-9]$' then concat('20',right(`a`.`Diabetes seit`,2)) when `a`.`Diabe" & _ 
  "tes seit` regexp '^[0-9]{4}$' then `a`.`Diabetes seit` when `a`.`Diabetes seit` regexp '[0-9]{4}' then regexp_substr(`a`.`Diabetes seit`,'[0-9]{4}') when `a`.`Diabetes seit` regexp '[ -.][0-9]+ [aJ]' then year(`a`.`Vorgestellt`) - substring_index(substr(regexp_substr(`a`.`Diabetes seit`,'[ -.][0-9]+ [aJ]'),2),' ',1) when `a`.`Diabetes seit` regexp '^[0-9]+ [aJ]' then year(`a`.`Vorgestellt`) - substring_index(regexp_substr(`a`.`Diabetes seit`,'^[0-9]+ [aJ]'),' ',1) when `a`.`Diabetes seit` regexp '^[0-9]+a' then year(`a`.`Vorgestellt`) - substring_index(substr(regexp_substr(`a`.`Diabetes seit`,'^[0-9]+a'),2),'a',1) when `a`.`Diabetes seit` regexp '[ -.][0-9]+ Mon' then year(`a`.`Vorgestellt` - interval substring_index(substr(regexp_substr(`a`.`Diabetes seit`,'[ -.][0-9]+ Mon'),2),' ',1) month) when `a`.`Diabetes seit` regexp '^[0-9]+ Mon' then year(`a`.`Vorgestellt` - interval substring_i" & _ 
