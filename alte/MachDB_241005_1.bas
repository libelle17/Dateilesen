 Str(1, 213, 0) = "CREATE ALGORITHM=UNDEFINED DEFINER=`praxis`@`%` SQL SECURITY DEFINER VIEW `lKrea` AS select `n`.`Pat_ID` AS `pat_id`,if(`l2`.`zeitpunkt` > `l1`.`ZeitPunkt` or `l1`.`ZeitPunkt` is null,`l2`.`zeitpunkt`,`l1`.`ZeitPunkt`) AS `lzp`,if(`l2`.`zeitpunkt` > `l1`.`ZeitPunkt` or `l1`.`ZeitPunkt` is null,`l2`.`wert`,`l2`.`wert`) AS `letzter` from ((`namen` `n` left join (select `u`.`Eingang` AS `zeitpunkt`,`w`.`Wert` AS `wert`,`w`.`Abkü` AS `abkü`,`u`.`Pat_id` AS `pat_id` from (`laboryus` `u` join `laborywert` `w` on(`w`.`UsID` = `u`.`ID` and `w`.`Abkü` in ('creat','krea02','krea','krea02','kres') and `w`.`Einheit` = 'mg/dl' and `u`.`Eingang` = (select max(`ui`.`Eingang`) from (`laborywert` `wi` join `laboryus` `ui` on(`wi`.`UsID` = `ui`.`ID`)) where `wi`.`Abkü` in ('creat','krea02','krea','krea02','kres') and `wi`.`Einheit` = 'mg/dl' and `ui`.`Pat_id` = `u`.`Pat_id`)))) `l2` on(" & _
  "`l2`.`pat_id` = `n`.`Pat_ID`)) left join `labor1a` `l1` on(`n`.`Pat_ID` = `l1`.`Pat_ID` and `l1`.`Abkü` in ('creat','krea02','krea','krea02','kres') and `l1`.`Einheit` = 'mg/dl' and `l1`.`ZeitPunkt` = (select max(`labor1a`.`ZeitPunkt`) from `labor1a` where `labor1a`.`Pat_ID` = `n`.`Pat_ID` and `labor1a`.`Abkü` in ('creat','krea02','krea','krea02','kres') and `labor1a`.`Einheit` = 'mg/dl'))) group by `n`.`Pat_ID`"
