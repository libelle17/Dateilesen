Sub FüllStr19()
 Str(0, 19, 0) = "aktlue"
 Str(1, 19, 0) = "CREATE ALGORITHM=UNDEFINED DEFINER=`praxis`@`%` SQL SECURITY DEFINER VIEW `aktlue` AS SELECT `i`.`ido` AS `ido`,`i`.`nameo` AS `nameo`,`i`.`vno` AS `vno`,`i`.`titelto` AS `titelto`,`i`.`kvnro` AS `kvnro`,`i`.`ide` AS `ide`,`ue`.`name` AS `name`,`ue`.`vorname` AS `vorname`,`ue`.`titelt` AS `titelt`,`ue`.`fachgruppe` AS `fachgruppe`,`ue`.`strasse` AS `strasse`,`ue`.`plz` AS `plz`,`ue`.`ort` AS `ort`,`ue`.`telefon` AS `telefon`,`ue`.`fax` AS `fax`,`ue`.`kvnr` AS `kvnr`,`ue`.`aktdat` AS `aktdat`,`ue`.`id` AS `id`,`ue`.`überschrift` AS `überschrift`,`ue`.`dbnr` AS `dbnr`,`ue`.`bstelle` AS `bstelle`,`ue`.`anrede` AS `anrede`,`ue`.`tel1` AS `tel1`,`ue`.`tel2` AS `tel2`,`ue`.`tel3` AS `tel3`,`ue`.`tel4` AS `tel4`,`ue`.`fax1` AS `fax1`,`ue`.`fax2` AS `fax2`,`ue`.`fax3` AS `fax3`,`ue`.`email` AS `email`,`ue`.`zulg` AS `zulg`,`ue`.`arzttyp` AS `arzttyp`,`ue`.`gemmit` AS `gemmit`,`" & _
  "ue`.`beme` AS `beme`,`ue`.`dmpt2` AS `dmpt2`,`ue`.`dmpt1` AS `dmpt1`,`ue`.`geschlecht` AS `geschlecht`,`ue`.`titel` AS `titel` FROM ((SELECT `l`.`id` AS `ido`,`l`.`name` AS `nameo`,`l`.`vorname` AS `vno`,`l`.`titelt` AS `titelto`,`l`.`kvnr` AS `kvnro`,(SELECT min(`e`.`id`) FROM `quelle`.`liuez` `e` WHERE `e`.`telefon` = `l`.`telefon` AND `e`.`fachgruppe`  NOT LIKE '% ehem%' AND `l`.`fachgruppe` like '% ehem%') AS `ide` FROM `quelle`.`liuez` `l`) `i` LEFT JOIN `quelle`.`liuez` `ue` on(`ue`.`id` = if(`i`.`ide` is null,`i`.`ido`,`i`.`ide`)))"
End Sub ' FüllStr19

