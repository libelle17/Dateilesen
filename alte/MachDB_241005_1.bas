 Str(1, 205, 0) = "CREATE ALGORITHM=UNDEFINED DEFINER=`praxis`@`%` SQL SECURITY DEFINER VIEW `lGFR` AS select `n`.`Pat_ID` AS `pat_id`,if(`l2`.`zeitpunkt` > `l1`.`ZeitPunkt` or `l1`.`ZeitPunkt` is null,`l2`.`zeitpunkt`,`l1`.`ZeitPunkt`) AS `lzp`,cast(replace(concat('0',trim(if(`l2`.`zeitpunkt` > `l1`.`ZeitPunkt` or `l1`.`ZeitPunkt` is null,`l2`.`wert`,`l1`.`Wert`))),',','.') as decimal(9,2)) AS `letzter` from ((`namen` `n` left join (select `u`.`Eingang` AS `zeitpunkt`,`w`.`Wert` AS `wert`,`w`.`Abkü` AS `abkü`,`u`.`Pat_id` AS `pat_id` from (`laboryus` `u` join `laborywert` `w` on(`w`.`UsID` = `u`.`ID` and `w`.`Abkü` regexp '^gfr|^gfck|^creacl|^m' and `u`.`Eingang` = (select max(`ui`.`Eingang`) from (`laborywert` `wi` join `laboryus` `ui` on(`wi`.`UsID` = `ui`.`ID`)) where `wi`.`Abkü` regexp '^gfr|^gfck|^creacl|^m' and `ui`.`Pat_id` = `u`.`Pat_id`)))) `l2` on(`l2`.`pat_id` = `n`.`Pat_ID`)" & _
  ") left join `labor1a` `l1` on(`n`.`Pat_ID` = `l1`.`Pat_ID` and `l1`.`Abkü` regexp '^gfr|^gfck|^creacl' and `l1`.`ZeitPunkt` = (select max(`labor1a`.`ZeitPunkt`) from `labor1a` where `labor1a`.`Pat_ID` = `n`.`Pat_ID` and `labor1a`.`Abkü` regexp '^gfr|^gfck|^creacl'))) group by `n`.`Pat_ID`"
