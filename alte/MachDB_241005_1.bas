Sub FüllStr7()
 Str(0, 7, 0) = "aktfvmta"
 Str(1, 7, 0) = "CREATE ALGORITHM=UNDEFINED DEFINER=`praxis`@`%` SQL SECURITY DEFINER VIEW `aktfvmta` AS select case when `i`.`dicd` like 'E10%' then '1' when `i`.`dicd` like 'E11%' then '2' when `i`.`dicd` = 'O24.4' then 'g' else '-' end AS `dtyp`,`i`.`mta` AS `mta`,`i`.`rang` AS `rang`,`i`.`tzp` AS `tzp`,`i`.`dicd` AS `dicd`,`i`.`pat_id` AS `pat_id`,`i`.`fid` AS `fid`,`i`.`schgr` AS `schgr`,`i`.`vknr` AS `vknr`,`i`.`ik` AS `ik`,`i`.`goäkatnr` AS `goäkatnr`,`i`.`lanrid` AS `lanrid`,`i`.`quartal` AS `quartal`,`i`.`kateg` AS `kateg` from (select coalesce(`t`.`therart`,'Diät') AS `mta`,`rang`(coalesce(`t`.`therart`,'Diät')) AS `rang`,`t`.`zp` AS `tzp`,(select max(`d`.`ICD`) from `diagview` `d` where `d`.`Pat_id` = `f`.`pat_id` and (`d`.`gicd` regexp '^E1[0-4].' and `d`.`obDauer` <> 0 or `d`.`ICD` = 'O24.4' and `d`.`Dggel` = 0 and `d`.`DiagSicherheit` in ('G',' ') and `d`.`obDauer` = 0 and " & _
  "`d`.`DiagDatum` between `qanf`() and `qend`())) AS `dicd`,`f`.`pat_id` AS `pat_id`,`f`.`fid` AS `fid`,`f`.`schgr` AS `schgr`,`f`.`vknr` AS `vknr`,`f`.`ik` AS `ik`,`f`.`goäkatnr` AS `goäkatnr`,`f`.`lanrid` AS `lanrid`,`f`.`quartal` AS `quartal`,`f`.`kateg` AS `kateg` from (`aktfv` `f` left join `therarten` `t` on(`t`.`pat_id` = `f`.`pat_id` and `t`.`zp` between coalesce((select max(`therarten`.`zp`) from `therarten` where `therarten`.`pat_id` = `f`.`pat_id` and `therarten`.`zp` < `qanf`()),19000101) and `qend`())) group by `f`.`pat_id`,`rang`(`t`.`therart`) desc) `i` group by `i`.`pat_id`"
End Sub ' FüllStr7

