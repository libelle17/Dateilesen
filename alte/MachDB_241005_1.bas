Sub FüllStr60()
 Str(0, 60, 0) = "dtypen"
 Str(1, 60, 0) = "CREATE ALGORITHM=UNDEFINED DEFINER=`praxis`@`%` SQL SECURITY DEFINER VIEW `dtypen` AS select `i`.`pat_id` AS `Pat_id`,`i`.`icd` AS `gicd`,`i`.`ityp` AS `ityp`,if(`i`.`obsek` <> 0 and `i`.`ityp` in ('1','2'),'s',`i`.`ityp`) AS `ttyp`,`i`.`diagtext` AS `diagtext`,`i`.`obsek` AS `obsek` from (select `n`.`Pat_ID` AS `pat_id`,`d`.`ICD` AS `icd`,`d`.`DiagText` AS `diagtext`,coalesce(`d`.`DiagText` regexp 'pan[ck]r|sekund',0) AS `obsek`,case left(`d`.`ICD`,1) when 'E' then case substr(`d`.`ICD`,3,1) when 1 then '2' when 0 then '1' when 3 then 's' else 'u' end when 'O' then 'g' when 'R' then 'p' else '-' end AS `ityp`,rank() over ( partition by `n`.`Pat_ID` order by coalesce(`d`.`DiagText` regexp 'pan[ck]r|sekund',0) desc,left(`d`.`gicd`,3),substr(`d`.`gicd`,5,1) = 9 desc,substr(`d`.`gicd`,5) desc,octet_length(`d`.`DiagText`) desc) AS `rang` from (`namen` `n` left join `diagvie" & _
  "w` `d` on(`d`.`Pat_id` = `n`.`Pat_ID` and (`d`.`gicd` regexp '^E1[0-4].|^R73' or `d`.`ICD` = 'O24.4' and `d`.`Dggel` = 0 and `d`.`DiagSicherheit` in ('G',' ')))) group by `n`.`Pat_ID`,`d`.`gicd`,`d`.`DiagText`) `i` where `i`.`rang` = 1"
End Sub ' FüllStr60

