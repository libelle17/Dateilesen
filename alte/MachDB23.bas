Sub FüllStr147()
 Str(0, 147, 0) = "lmp"
 Str(1, 147, 0) = "CREATE ALGORITHM=UNDEFINED DEFINER=`praxis`@`%` SQL SECURITY DEFINER VIEW `lmp` AS SELECT `mp`.`FID` AS `FID`,`mp`.`Pat_ID` AS `Pat_ID`,`mp`.`MPNr` AS `MPNr`,`mp`.`ZeitPunkt` AS `ZeitPunkt`,`mp`.`Datum` AS `Datum`,`mp`.`Medikament` AS `Medikament`,`mp`.`MedAnfang` AS `MedAnfang`,`mp`.`Wirkstoff` AS `Wirkstoff`,`mp`.`PZN` AS `PZN`,`mp`.`FeldNr` AS `FeldNr`,`mp`.`mo` AS `mo`,`mp`.`mi` AS `mi`,`mp`.`nm` AS `nm`,`mp`.`ab` AS `ab`,`mp`.`zn` AS `zn`,`mp`.`bBed` AS `bBed`,`mp`.`Bemerkung` AS `Bemerkung`,`mp`.`Grund` AS `Grund`,`mp`.`Stärke` AS `Stärke`,`mp`.`Einheit` AS `Einheit`,`mp`.`Form` AS `Form`,`mp`.`AbsPos` AS `AbsPos`,`mp`.`AktZeit` AS `AktZeit`,`mp`.`StByte` AS `StByte` FROM (`_fuerlmp` `i` join `medplan` `mp` on(`i`.`pat_id` = `mp`.`Pat_ID` AND `i`.`mpnr` = `mp`.`MPNr`))"
End Sub ' FüllStr147

