 Str(1, 222, 0) = "CREATE ALGORITHM=UNDEFINED DEFINER=`praxis`@`%` SQL SECURITY DEFINER VIEW `aktfvmi` AS select `f`.`pat_id` AS `pat_id`,`f`.`fid` AS `fid`,`f`.`schgr` AS `schgr`,`f`.`vknr` AS `vknr`,`f`.`ik` AS `ik`,`f`.`goäkatnr` AS `goäkatnr`,`f`.`lanrid` AS `lanrid`,`f`.`quartal` AS `quartal`,(select max(`kassenliste`.`Kateg`) from `kassenliste` where `kassenliste`.`VKNR` = `f`.`vknr` and `kassenliste`.`IK` = `f`.`ik`) AS `kateg` from `aktf` `f` where `f`.`quartal` = `quartal`(current_timestamp() - interval 21 day) group by `f`.`pat_id` order by `f`.`pat_id`"
End Sub ' FüllStr222

