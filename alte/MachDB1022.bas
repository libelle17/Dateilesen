Sub FüllStr56()
 Str(0, 56, 0) = "dtypen"
 Str(1, 56, 0) = "CREATE ALGORITHM=UNDEFINED DEFINER=`praxis`@`%` SQL SECURITY DEFINER VIEW `dtypen` AS select `i`.`pat_id` AS `Pat_id`,`i`.`gicd` AS `gicd`,`i`.`ityp` AS `ityp`,if(`i`.`obsek` <> 0 and `i`.`ityp` in ('1','2'),'s',`i`.`ityp`) AS `ttyp`,`i`.`diagtext` AS `diagtext`,`i`.`obsek` AS `obsek` from (select `n`.`Pat_ID` AS `pat_id`,`d`.`gICD` AS `gicd`,`d`.`DiagText` AS `diagtext`,coalesce(`d`.`DiagText` regexp 'pan[ck]r|sekund',0) AS `obsek`,case left(`d`.`gICD`,1) when 'E' then case substr(`d`.`gICD`,3,1) when 1 then '2' when 0 then '1' when 3 then 's' else 'u' end when 'O' then 'g' when 'R' then 'p' else '-' end AS `ityp`,rank() over ( partition by `n`.`Pat_ID` order by coalesce(`d`.`DiagText` regexp 'pan[ck]r|sekund',0) desc,left(`d`.`gICD`,3),substr(`d`.`gICD`,5,1) = 9 desc,substr(`d`.`gICD`,5) desc,octet_length(`d`.`DiagText`) desc) AS `rang` from (`namen` `n` left join `di" & _ 
  "agnosen` `d` on(`d`.`Pat_id` = `n`.`Pat_ID` and `d`.`gICD` regexp '^E1[0-4].|^O24|^R73')) group by `n`.`Pat_ID`,`d`.`gICD`,`d`.`DiagText`) `i` where `i`.`rang` = 1"
End Sub ' FüllStr56

