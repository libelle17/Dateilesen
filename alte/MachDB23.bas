Sub FüllStr132()
 Str(0, 132, 0) = "geslaba"
 Str(1, 132, 0) = "CREATE ALGORITHM=UNDEFINED DEFINER=`praxis`@`%` SQL SECURITY DEFINER VIEW `geslaba` AS SELECT group_concat(`i`.`wert` SEPARATOR '<br>') AS `wert`,`i`.`abkü` AS `abkü`,`i`.`einheit` AS `einheit`,`i`.`zeitpunkt` AS `Zeitpunkt`,`i`.`nb` AS `NB`,`i`.`gruppe` AS `gruppe`,`i`.`reihe` AS `reihe`,`i`.`uNg` AS `uNg`,`i`.`oNg` AS `oNg`,`i`.`Pfad` AS `Pfad`,`i`.`Kommentar` AS `Kommentar`,`i`.`Labor` AS `Labor`,`i`.`Langtext` AS `Langtext`,`i`.`pat_id` AS `pat_id` FROM (SELECT `i`.`wert` AS `wert`,`i`.`abkü` AS `abkü`,`i`.`einheit` AS `einheit`,`i`.`zeitpunkt` AS `zeitpunkt`,`i`.`nb` AS `nb`,`i`.`gruppe` AS `gruppe`,`i`.`reihe` AS `reihe`,`i`.`uNg` AS `uNg`,`i`.`oNg` AS `oNg`,`i`.`Pfad` AS `Pfad`,`i`.`Kommentar` AS `Kommentar`,`i`.`Labor` AS `Labor`,`i`.`Langtext` AS `Langtext`,`i`.`pat_id` AS `pat_id` FROM (SELECT `l2`.`Wert` AS `wert`,`l2`.`Abkü` AS `abkü`,`l2`.`Einheit` AS `ein" & _
  "heit`,`l2`.`Zeitpunkt` AS `zeitpunkt`,`l2`.`NB` AS `nb`,`l2`.`Gruppe` AS `gruppe`,`l2`.`Reihe` AS `reihe`,`l2`.`uNg` AS `uNg`,`l2`.`oNg` AS `oNg`,`l2`.`Pfad` AS `Pfad`,`l2`.`Kommentar` AS `Kommentar`,`l2`.`Labor` AS `Labor`,`l2`.`Langtext` AS `Langtext`,`l2`.`Pat_id` AS `pat_id` FROM `quelle`.`labor2a` `l2` WHERE `l2`.`Pat_id` = `patid`() union SELECT `l1`.`Wert` AS `wert`,`l1`.`Abkü` AS `abkü`,`l1`.`Einheit` AS `einheit`,`l1`.`ZeitPunkt` AS `zeitpunkt`,`l1`.`NB` AS `nb`,`l1`.`Gruppe` AS `gruppe`,`l1`.`Reihe` AS `reihe`,`l1`.`uNg` AS `uNg`,`l1`.`oNg` AS `oNg`,`l1`.`Pfad` AS `Pfad`,`l1`.`Kommentar` AS `Kommentar`,`l1`.`Labor` AS `Labor`,`l1`.`Langtext` AS `Langtext`,`l1`.`Pat_ID` AS `pat_id` FROM `quelle`.`labor1a` `l1` WHERE `l1`.`Pat_ID` = `patid`()) `i` GROUP BY `i`.`zeitpunkt`,`i`.`abkü`,`i`.`wert`) `i` GROUP BY `i`.`abkü`,`i`.`einheit`,`i`.`nb`,`i`.`zeitpunkt` ORDER BY `i`.`zeitpunkt" & _
  "` DESC,`i`.`abkü`,group_concat(`i`.`wert` SEPARATOR '<br>'),`i`.`einheit`,`i`.`nb`"
End Sub ' FüllStr132

