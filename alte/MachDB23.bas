Sub FüllStr114()
 Str(0, 114, 0) = "aktfvmta"
 Str(1, 114, 0) = "CREATE ALGORITHM=UNDEFINED DEFINER=`praxis`@`%` SQL SECURITY DEFINER VIEW `aktfvmta` AS SELECT case when `i`.`dicd` like 'E10%' then '1' when `i`.`dicd` like 'E11%' then '2' when `i`.`dicd` = 'O24.4' then 'g' else '-' end AS `dtyp`,`i`.`mta` AS `mta`,`i`.`rang` AS `rang`,`i`.`tzp` AS `tzp`,`i`.`dicd` AS `dicd`,`i`.`pat_id` AS `pat_id`,`i`.`fid` AS `fid`,`i`.`schgr` AS `schgr`,`i`.`goäkatnr` AS `goäkatnr`,`i`.`vknr` AS `vknr`,`i`.`kateg` AS `kateg`,`i`.`lanrid` AS `lanrid` FROM (SELECT COALESCE(`t`.`therart`,'Diät') AS `mta`,`rang`(COALESCE(`t`.`therart`,'Diät')) AS `rang`,`t`.`zp` AS `tzp`,(SELECT max(`quelle`.`diagnosen`.`ICD`) FROM `quelle`.`diagnosen` WHERE `quelle`.`diagnosen`.`Pat_id` = `f`.`pat_id` AND (`quelle`.`diagnosen`.`ICD` regexp '^E1[0-4].' AND `quelle`.`diagnosen`.`obDauer` <> 0 OR `quelle`.`diagnosen`.`ICD` = 'O24.4' AND `quelle`.`diagnosen`.`obDauer` =" & _
  " 0 AND `quelle`.`diagnosen`.`DiagDatum` between `qanf`() AND `qend`()) AND `quelle`.`diagnosen`.`DiagSicherheit` in (' ','G') AND COALESCE(`quelle`.`diagnosen`.`f6010`,0) = 0) AS `dicd`,`f`.`pat_id` AS `pat_id`,`f`.`fid` AS `fid`,`f`.`schgr` AS `schgr`,`f`.`goäkatnr` AS `goäkatnr`,`f`.`vknr` AS `vknr`,`f`.`kateg` AS `kateg`,`f`.`lanrid` AS `lanrid` FROM (`quelle`.`aktfv` `f` LEFT JOIN `quelle`.`therarten` `t` on(`t`.`pat_id` = `f`.`pat_id` AND `t`.`zp` between COALESCE((SELECT max(`quelle`.`therarten`.`zp`) FROM `quelle`.`therarten` WHERE `quelle`.`therarten`.`pat_id` = `f`.`pat_id` AND `quelle`.`therarten`.`zp` < `qanf`()),19000101) AND `qend`())) GROUP BY `f`.`pat_id`,`rang`(`t`.`therart`) desc) `i` GROUP BY `i`.`pat_id`"
End Sub ' FüllStr114

