 Str(1, 212, 0) = "CREATE ALGORITHM=UNDEFINED DEFINER=`praxis`@`%` SQL SECURITY DEFINER VIEW `konz` AS SELECT `i`.`pat_id` AS `pat_id`,`i`.`fid` AS `fid`,COUNT(DISTINCT `i`.`zp`) AS `koz`,group_concat(DISTINCT DATE_FORMAT(`i`.`zp`,'%e.%c.') ORDER BY `i`.`zp` ASC SEPARATOR '•') AS `czp`,min(`i`.`zp`) AS `erst`,max(`i`.`zp`) AS `letzt` FROM (SELECT `quelle`.`eintraege`.`Pat_ID` AS `pat_id`,CAST(`quelle`.`eintraege`.`ZeitPunkt` AS date) AS `zp`,`quelle`.`eintraege`.`FID` AS `fid` FROM `quelle`.`eintraege` WHERE `quelle`.`eintraege`.`ZeitPunkt` between CAST(concat(year(current_timestamp() - interval 21 day),'-',(quarter(current_timestamp() - interval 21 day) - 1) * 3 + 1,'-01') AS date) AND concat(year(current_timestamp() - interval 21 day) + quarter(current_timestamp() - interval 21 day) DIV 4,'-',((quarter(current_timestamp() - interval 21 day) - 1) * 3 + 4) MOD 12,'-01') - interval 1 seco" & _
  "nd union SELECT `quelle`.`leistungen`.`Pat_ID` AS `pat_id`,CAST(`quelle`.`leistungen`.`ZeitPunkt` AS date) AS `zp`,`quelle`.`leistungen`.`FID` AS `fid` FROM `quelle`.`leistungen` WHERE `quelle`.`leistungen`.`ZeitPunkt` between CAST(concat(year(current_timestamp() - interval 21 day),'-',(quarter(current_timestamp() - interval 21 day) - 1) * 3 + 1,'-01') AS date) AND concat(year(current_timestamp() - interval 21 day) + quarter(current_timestamp() - interval 21 day) DIV 4,'-',((quarter(current_timestamp() - interval 21 day) - 1) * 3 + 4) MOD 12,'-01') - interval 1 second union SELECT `quelle`.`rezepteintraege`.`Pat_ID` AS `pat_id`,CAST(`quelle`.`rezepteintraege`.`ZeitPunkt` AS date) AS `zp`,`quelle`.`rezepteintraege`.`FID` AS `fid` FROM `quelle`.`rezepteintraege` WHERE `quelle`.`rezepteintraege`.`ZeitPunkt` between CAST(concat(year(current_timestamp() - interval 21 day),'-',(quarter(current" & _
  "_timestamp() - interval 21 day) - 1) * 3 + 1,'-01') AS date) AND concat(year(current_timestamp() - interval 21 day) + quarter(current_timestamp() - interval 21 day) DIV 4,'-',((quarter(current_timestamp() - interval 21 day) - 1) * 3 + 4) MOD 12,'-01') - interval 1 second) `i` GROUP BY `i`.`pat_id`"
End Sub ' FüllStr212

